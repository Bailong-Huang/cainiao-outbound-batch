{
  "manifest_version": 3,
  "name": "菜鸟批量出库助手",
  "version": "1.0.5",
  "description": "按面单日期选择速卖通订单，辅助填写菜鸟海外仓出库单。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["sidePanel", "scripting", "tabs", "storage", "clipboardRead"],
  "host_permissions": [
    "https://b.gfn.cainiao.com/*",
    "https://csp.aliexpress.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "菜鸟批量出库助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://b.gfn.cainiao.com/*", "https://csp.aliexpress.com/*"],
      "js": ["address.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
